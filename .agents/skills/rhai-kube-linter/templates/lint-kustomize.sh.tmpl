#!/usr/bin/env bash
# =============================================================================
# kube-linter Kustomize lint script — TEMPLATE (rhai-kube-linter onboarding)
#
# Scaffold from .agents/skills/rhai-kube-linter/templates/lint-kustomize.sh.tmpl,
# specialize every __PLACEHOLDER_*__ value from the repository's actual facts,
# and install at scripts/lint-kustomize.sh. Scaffold this script only when the
# repository has Kustomize roots; repositories with Helm charts also get
# scripts/lint-helm.sh. The Makefile `lint-manifests` target (or the workflow,
# when there is no Makefile) invokes only the scripts the repository needs.
# Refuses to run while unspecialized.
#
# Contract (do not weaken when specializing):
# - EXTERNAL RENDERING: every Kustomize root is rendered by the pinned
#   Kustomize CLI into ONE scratch multi-document file per root, and
#   kube-linter lints that file only after a successful render. Roots are
#   never passed to kube-linter directly, and there is no native-renderer
#   fallback. (v0.8.3 groups plain-YAML lint contexts by containing
#   directory, so one file per root is what keeps related resources in a
#   single context; each overlay is its own entry.)
# - Select roots by deployment context — the overlay the deploying
#   module/operator actually uses. Transformations (namePrefix, namespace,
#   ...) belong in the kustomization itself; there are no per-root renderer
#   arguments.
# - Remote references are fetched by the pinned renderer exactly as the
#   root's kustomization specifies; record them in the report's provenance.
# - Chart generators: the render passes --enable-helm so roots declaring
#   `helmCharts` inflate (without it the build fails outright). Kustomize
#   execs `helm` from PATH for inflation — chart reach (local bases
#   outside any scanned directory, remote bases, components) is not
#   locally enumerable, so the script installs the PINNED Helm
#   (HELM_VERSION, the same module pin chart rendering uses) into scratch
#   UNCONDITIONALLY and prepends it to PATH: every render that can
#   inflate a chart runs the recorded version, never a host helm, and a
#   chart-free repository pays one unused binary in scratch. Remote chart
#   repositories are remote inputs
#   for the report's provenance. Pulling a remote-repo chart WRITES the
#   pulled chart into the root's chart home
#   (helmGlobals.chartHome if set, else <root>/charts/) — kustomize
#   rejects a chart home outside the root, so the write cannot be
#   redirected to scratch. It is the ONE renderer-owned write into the
#   consumer tree, occurs only for helmCharts entries with a remote `repo`
#   (locally present charts are only read), happens even when the render
#   subsequently fails, and is never cleaned up automatically (a pulled
#   chart is indistinguishable from a checked-in one). Onboarding proposes
#   gitignoring the chart home or vendoring the chart; the assessment
#   records the write in the report's provenance.
# - Fails on: selected-check violations, render failures, empty or
#   comment-only renders, invalid resources, an empty root list, zero
#   enabled checks, missing or malformed reports, missing entry files, and
#   missing prerequisites. Never tune to green.
# - Every root renders even when an earlier one fails; failures aggregate.
# - Raw artifacts (renders, JSON/plain reports, stderr) may contain Secret
#   material: restrictive permissions, gitignored scratch only, never
#   printed or uploaded — console output carries stage/status summaries and
#   artifact paths only.
#
# Prerequisites: bash >= 3.2 (no associative arrays, namerefs, or newer-only
# expansions are used), the Go toolchain — Go >= 1.26, required by the Helm 4
# pin below as well as current kube-linter/Kustomize releases — all tools run
# via pinned `go run`, and the pinned Helm binary for chart inflation is
# installed from the pinned module below on every run (no host helm install
# required) — modules download on first use (network required) — and jq.
# =============================================================================

set -uo pipefail
# No `-e`: each entry's status is checked explicitly and must not abort the
# loop. Empty arrays use the `${arr[@]+"${arr[@]}"}` guard (bash 3.2 + set -u).

# --- Tool pins -----------------------------------------------------------------
# Version-qualified `go run`: the Go toolchain checksum-verifies module
# downloads, and the pin here is the evidence of what ran. When changing a
# pin, re-verify check names/flags against that release and record the change.
KUBE_LINTER_VERSION="__PLACEHOLDER_KUBE_LINTER_PIN__"   # seed: v0.8.3 (golang.stackrox.io/kube-linter/cmd/kube-linter)
KUSTOMIZE_VERSION="__PLACEHOLDER_KUSTOMIZE_PIN__"       # seed: v5.8.1, or the repository's compatible pin (sigs.k8s.io/kustomize/kustomize/v5)
# Helm for KUSTOMIZE CHART INFLATION: Kustomize execs `helm` from PATH, and
# chart reach is not locally enumerable, so the script installs this pinned
# binary into scratch and prepends it to PATH on every run — chart rendering
# itself keeps using the pinned `go run` in lint-helm.sh. The pin is the
# evidence of what ran (a go-installed binary self-reports an unstamped
# version).
HELM_VERSION="__PLACEHOLDER_HELM_PIN__"                 # seed: v4.3.2 (helm.sh/helm/v4/cmd/helm — REQUIRES Go >= 1.26)

# --- Configuration ------------------------------------------------------------
CONFIG="__PLACEHOLDER_CONFIG_PATH__"     # e.g. .kube-linter.yaml (relative to repo root)
REPORT_DIR="__PLACEHOLDER_REPORT_DIR__"  # scratch reports, e.g. .kube-linter-reports — must be git-ignored (enforced fail-closed) or outside the repository

# --- Lint roots: name|root (root relative to repo root) ------------------------
# The root is a directory containing kustomization.yaml, kustomization.yml,
# or Kustomization. Names are unique, match [A-Za-z0-9._-], and name the
# scratch artifacts.
ROOTS=(
  "__PLACEHOLDER_ROOT_NAME|ROOT__"
)

# --- Refuse to run unspecialized ------------------------------------------------
# Anchored on an uppercase letter so the guard cannot match its own source.
if grep -qE '__PLACEHOLDER_[A-Z]' "$0"; then
  echo "ERROR: unspecialized template — fill every __PLACEHOLDER_*__ value in $0" >&2
  exit 1
fi

# --- Environment -----------------------------------------------------------------
# umask makes every artifact private on creation; each reset re-chmods so
# loose permissions on existing artifacts are corrected (or fail closed).
umask 077
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"
mkdir -p "$REPORT_DIR" || { echo "ERROR: cannot create $REPORT_DIR" >&2; exit 1; }
chmod 700 "$REPORT_DIR" 2>/dev/null || { echo "ERROR: cannot secure $REPORT_DIR permissions — failing closed" >&2; exit 1; }
# The linter runs on the host: this script writes only into REPORT_DIR and
# never modifies lint targets — the single exception is the renderer's
# chart pull documented in the header (a remote-repo helmCharts entry
# writes its pulled chart into the root's chart home). REPORT_DIR is
# disposable gitignored scratch.
REPORT_DIR="$(cd "$REPORT_DIR" && pwd)"
# Raw artifacts may contain Secret material, so an in-repository REPORT_DIR
# is allowed only when PROVABLY uncommittable: fail closed unless git
# confirms it is ignored (a location outside the repository cannot be
# committed; a repository without git cannot commit either).
case "$REPORT_DIR" in
  "$REPO_ROOT"/*)
    if git rev-parse --git-dir >/dev/null 2>&1 && ! git check-ignore -q -- "$REPORT_DIR"; then
      echo "ERROR: $REPORT_DIR is inside the repository but not git-ignored — raw reports may contain Secret material; gitignore it or point REPORT_DIR outside the repository" >&2
      exit 1
    fi
    ;;
esac
# Artifacts live in a per-renderer subdirectory: names are unique only within
# this script's own list, and this keeps the helm script's evidence intact
# when a root and a chart share a name.
REPORT_DIR="$REPORT_DIR/kustomize"
mkdir -p "$REPORT_DIR" || { echo "ERROR: cannot create $REPORT_DIR" >&2; exit 1; }

# --- Prerequisites -----------------------------------------------------------
if ! command -v go >/dev/null 2>&1; then
  echo "ERROR: go is required (pins: kube-linter ${KUBE_LINTER_VERSION}, kustomize ${KUSTOMIZE_VERSION})" >&2
  exit 1
fi
command -v jq >/dev/null 2>&1 || { echo "ERROR: jq is required to validate lint reports" >&2; exit 1; }
[ -f "$CONFIG" ] || { echo "ERROR: config not found: $CONFIG" >&2; exit 1; }
if [ "${#ROOTS[@]}" -eq 0 ] || [ "${ROOTS[0]:-}" = "" ]; then
  echo "ERROR: no lint roots configured — an empty target set is a failure, not a pass" >&2
  exit 1
fi

# --- Pinned Helm for chart inflation -------------------------------------------
# Kustomize inflates `helmCharts` by exec'ing `helm` from PATH — and chart
# reach is not locally enumerable: a chart can arrive through a local base
# anywhere relative paths can reach (including outside every scanned
# directory), a remote base, or a component. The pinned Helm is therefore
# installed UNCONDITIONALLY into scratch and prepended to PATH: every
# render that can inflate a chart runs the recorded version, never a host
# helm, and a chart-free repository pays one unused binary in scratch. The
# pin is the evidence of what ran; a go-installed binary self-reports an
# unstamped version.
HELM_BIN_DIR="${REPORT_DIR}/helm-bin"
mkdir -p "$HELM_BIN_DIR" || { echo "ERROR: cannot create $HELM_BIN_DIR" >&2; exit 1; }
echo "helm: installing pinned helm ${HELM_VERSION} for chart inflation (unconditional — chart reach is not locally enumerable)"
if ! env GOFLAGS= GOWORK=off GOBIN="$HELM_BIN_DIR" go install "helm.sh/helm/v4/cmd/helm@${HELM_VERSION}" 2>"${REPORT_DIR}/helm-install.stderr"; then
  echo "ERROR: failed to install pinned helm ${HELM_VERSION} — see ${REPORT_DIR}/helm-install.stderr" >&2
  exit 1
fi
PATH="${HELM_BIN_DIR}:${PATH}"
export PATH

# --- Helpers -------------------------------------------------------------------
failures=0
seen_names=" "

die() { echo "ERROR: $1" >&2; }

# truncate in place (an empty file fails report validation, so a run that
# writes nothing cannot pass) and force mode 600 on every reset
reset_artifact() { : > "$1" 2>/dev/null && chmod 600 "$1" 2>/dev/null; }

# at least one line that is not blank/comment/separator: empty or
# comment-only renders are failures, not passes
has_content() { grep -Eq '^[^[:space:]#-]' "$1" 2>/dev/null; }

# report parses as JSON with >= 1 enabled check (a zero-check config exits
# successfully WITHOUT writing a report — the classic false-green)
checks_enabled() { jq -e '(.Checks | type == "array") and (.Checks | length > 0)' "$1" >/dev/null 2>&1; }

# reset every artifact for one root before any stage, so a failed or partial
# run never leaves stale evidence behind
reset_profile() {
  local f
  for f in "$1.rendered.yaml" "$1.json" "$1.txt" "$1.render.stderr" "$1.stderr"; do
    reset_artifact "${REPORT_DIR}/$f" || return 1
  done
}

# --- Lint ----------------------------------------------------------------------
# run_lint <name> <rendered-file> — pinned kube-linter on one rendered file.
# JSON plus human-readable plain reports (v0.8.3 has no `pretty` format).
run_lint() {
  local name="$1" target="$2"
  local report="${REPORT_DIR}/${name}.json" plain="${REPORT_DIR}/${name}.txt" log="${REPORT_DIR}/${name}.stderr"
  local status=0
  # GOFLAGS/GOWORK are cleared per command via `env` so the version-qualified
  # `go run` is standalone and insulated from the consumer's Go configuration.
  env GOFLAGS= GOWORK=off go run "golang.stackrox.io/kube-linter/cmd/kube-linter@${KUBE_LINTER_VERSION}" lint \
      --config "$CONFIG" \
      --format json  --output "$report" \
      --format plain --output "$plain" \
      --fail-if-no-objects-found --fail-on-invalid-resource \
      "$target" 2>"$log" || status=$?
  # --fail-on-invalid-resource: deprecated in v0.8.3 (hidden from --help) but
  # functional; do not remove without replacing this guard.
  if [ "$status" -ne 0 ]; then
    echo "FAIL: root '$name' (lint exit ${status}) — see $log and $plain" >&2
    failures=$((failures + 1))
    return 0
  fi
  if [ ! -s "$report" ] || ! checks_enabled "$report"; then
    die "root '$name': report missing, malformed, or zero enabled checks"
    failures=$((failures + 1))
    return 0
  fi
  echo "PASS: root '$name' (report: $report)"
}

# render_and_lint <name> <renderer command...> — run the renderer into the
# root's single multi-doc file, guard the outcome, then lint that file.
# A failed or content-free render is never linted.
render_and_lint() {
  local name="$1"; shift
  local rendered="${REPORT_DIR}/${name}.rendered.yaml"
  local rlog="${REPORT_DIR}/${name}.render.stderr"
  local status=0
  "$@" >"$rendered" 2>"$rlog" || status=$?
  if [ "$status" -ne 0 ]; then
    die "root '$name': render FAILED (exit ${status}) — not linted; see $rlog"
    failures=$((failures + 1))
    return 0
  fi
  if ! has_content "$rendered"; then
    die "root '$name': render produced empty or comment-only output — not linted"
    failures=$((failures + 1))
    return 0
  fi
  run_lint "$name" "$rendered"
}

# --- Render and lint every root -------------------------------------------------
for entry in "${ROOTS[@]}"; do
  [ -n "$entry" ] || continue
  name="${entry%%|*}"; target="${entry#*|}"
  # Root names become artifact filenames: reject anything that could escape
  # REPORT_DIR or collide.
  case "$name" in
    ''|.*|*..*|*[!A-Za-z0-9._-]*)
      die "invalid root name '$name' (unique, [A-Za-z0-9._-], no leading dot, no '..')"
      failures=$((failures + 1)); continue ;;
  esac
  case " $seen_names " in
    *" $name "*)
      die "duplicate root name '$name' — names must be unique"
      failures=$((failures + 1)); continue ;;
  esac
  seen_names=" $seen_names $name "
  # Reset this root's artifacts up front (fail-closed): failed and successful
  # runs all start from empty evidence.
  if ! reset_profile "$name"; then
    die "root '$name': cannot reset/secure scratch artifacts in $REPORT_DIR — failing closed"
    failures=$((failures + 1)); continue
  fi
  # Absolute and remote targets are used verbatim (a remote root fails the
  # entry-file check below with its real URL, not a prefixed path); only
  # relative local paths are anchored to the repo root.
  case "$target" in
    /*|*://*) ;;
    *) target="$REPO_ROOT/$target" ;;
  esac
  # All three entry-point filenames take this one external path (v0.8.3's
  # bundled loader misses `Kustomization`; the pinned CLI renders every root).
  if [ ! -f "$target/kustomization.yaml" ] && [ ! -f "$target/kustomization.yml" ] && [ ! -f "$target/Kustomization" ]; then
    die "root '$name': no kustomization entry file (kustomization.yaml|.yml|Kustomization) in $target"
    failures=$((failures + 1)); continue
  fi
  render_and_lint "$name" \
    env GOFLAGS= GOWORK=off go run "sigs.k8s.io/kustomize/kustomize/v5@${KUSTOMIZE_VERSION}" build --enable-helm "$target"
done

echo
if [ "$failures" -gt 0 ]; then
  echo "kube-linter: FAILED (${failures} root failure(s)). Reports in ${REPORT_DIR}/" >&2
  exit 1
fi
echo "kube-linter: all roots passed. Reports in ${REPORT_DIR}/"
