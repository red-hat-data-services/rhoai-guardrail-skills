# =============================================================================
# kube-linter workflow template
#
# SPECIALIZE:
# - __PLACEHOLDER_DEFAULT_BRANCH__ from origin/HEAD (never guess).
# - __PLACEHOLDER_GO_VERSION__ from the selected tool pins and consumer setup.
# - __PLACEHOLDER_LINT_COMMAND__ from the entry-point recipe.
# Kustomize chart inflation uses Helm from the caller's PATH.
# =============================================================================
name: kube-linter

on:
  pull_request:
  push:
    branches: [__PLACEHOLDER_DEFAULT_BRANCH__]
  workflow_dispatch:

permissions:
  contents: read
  security-events: write

jobs:
  kube-linter:
    runs-on: ubuntu-latest
    env:
      # Set to 'false' to warn on selected-check findings.
      KUBE_LINTER_FAIL_ON_FINDINGS: 'true'
    steps:
      # actions/checkout v7.0.1
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - uses: actions/setup-go@d8cbb8045d7f43706b9177cceb36c1f91a6644d5
        with:
          go-version: '__PLACEHOLDER_GO_VERSION__'
      - name: Lint manifests
        id: lint
        env:
          KUBE_LINTER_SARIF_DIR: ${{ runner.temp }}/kube-linter
        run: __PLACEHOLDER_LINT_COMMAND__
      - name: Upload kube-linter SARIF
        if: ${{ !cancelled() && steps.lint.outputs.sarif-ready == 'true' }}
        uses: github/codeql-action/upload-sarif@915412ff23e8b7659517e607487dbeae018f2934 # v4.39.5
        with:
          sarif_file: ${{ runner.temp }}/kube-linter/report.sarif
