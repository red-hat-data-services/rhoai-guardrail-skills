#!/usr/bin/env bash
#
# install-cert-manager.sh
#
# Install the cert-manager controller (CRDs, deployments, and webhook) on an
# existing Kind cluster via Helm, from the pinned jetstack chart version
# baked below. The install is never floating: the exact chart version is
# passed to 'helm upgrade --install --version'.
#
# This script was generated by the rhai-kind-setup skill and is
# standalone: it requires no sibling scripts or helpers. It targets Bash 3.2
# (no associative arrays, mapfile, or namerefs) and runs on macOS
# (/bin/bash) and Linux.
#
# Steps, in order:
#   1. check the prerequisites this script uses (go, kubectl, helm 3.13,
#      the selected container engine, and a few POSIX text tools);
#   2. validate the baked settings;
#   3. create a private scratch directory in the system temporary
#      directory with mktemp (removed on exit; nothing is persisted next
#      to this script);
#   4. verify the named Kind cluster exists via the pinned kind version,
#      export that cluster's kubeconfig into the private scratch
#      directory, and pass that kubeconfig to every kubectl and helm
#      invocation; helm repository state is kept in the same private
#      scratch, so the user's global helm configuration is never read or
#      changed;
#   5. read-only preflight: if cert-manager APIs already exist on the
#      cluster but the Helm release below does not own them, stop — and
#      if the Helm release exists but was installed from a different
#      chart, stop too; this script never takes over an installation
#      made by other means;
#   6. 'helm upgrade --install' the pinned chart with CRDs enabled and a
#      bounded wait — an existing release keeps its user-supplied values
#      (--reuse-values; a fresh install has none to reuse) — then verify
#      the release's deployments are Available and the
#      certificates.cert-manager.io CRD is Established.
#
# A failure leaves explicitly reported partial state and does not roll
# back, uninstall, or delete anything. Re-running upgrades in place to the
# same pinned chart version; it never moves beyond it.
#
# Network is required on first run: the pinned kind tool is downloaded by
# the Go toolchain (module sources land in the shared Go module cache),
# and the jetstack Helm repository index plus the pinned chart are
# downloaded by helm into the private scratch repository cache.
#
# Installing cert-manager provides certificate issuance for consumers
# that need it (for example webhook CA injection). It does not configure
# any Issuer, ClusterIssuer, or Certificate: those belong to the consumer.

set -Eeuo pipefail
umask 077

# ---------------------------------------------------------------------------
# Settings baked by the rhai-kind-setup skill
# ---------------------------------------------------------------------------
# These values were substituted when this script was generated and reflect
# what was verified during generation. They must stay shell-safe: no quotes
# and no parameter-expansion characters.

# Name of the existing Kind cluster to install cert-manager into.
KIND_CLUSTER_NAME="%%KIND_CLUSTER_NAME%%"

# The container engine (docker, podman, ...) is deliberately not a baked
# setting. kind selects its engine from the environment —
# KIND_EXPERIMENTAL_PROVIDER when set, otherwise autodetection (docker
# first, then nerdctl, then podman in recent versions) — and this script
# never sets or forces that choice, so the same generated script works
# in any environment, with whatever engine backs the user's cluster.
# The cluster name above is the only cluster identity.

# Exact pinned kind version, run via: go run sigs.k8s.io/kind@<version>
KIND_VERSION="%%KIND_VERSION%%"

# Exact pinned cert-manager Helm chart version, resolved by the
# rhai-kind-setup skill at generation time (the latest stable release
# then) and confirmed with the user. Passed to 'helm upgrade --install
# --version'; the install is never floating.
CERT_MANAGER_VERSION="%%CERT_MANAGER_VERSION%%"

# ---------------------------------------------------------------------------
# Script-owned settings
# ---------------------------------------------------------------------------

# Helm release and namespace for the installation. The preflight in Step 5
# keys on both: existing cert-manager APIs not owned by this exact release
# and namespace stop the script.
CERT_MANAGER_RELEASE_NAME="cert-manager"
CERT_MANAGER_NAMESPACE="cert-manager"

# Helm repository the chart is installed from.
HELM_REPO_NAME="jetstack"
HELM_REPO_URL="https://charts.jetstack.io"

# Bounded waits: the helm release itself, then the release's deployments
# and the namesake CRD.
HELM_WAIT_TIMEOUT="300s"
DEPLOYMENT_TIMEOUT="180s"
CRD_ESTABLISHED_TIMEOUT="180s"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

fail() {
	echo "ERROR: $*" >&2
	exit 1
}

info() {
	echo "==> $*"
}

need_cmd() {
	command -v "$1" >/dev/null 2>&1 ||
		fail "missing required command '$1' (prerequisite for this script)"
}

# Reject empty values and characters outside the shell-safe set that baked
# settings are allowed to contain. This also rejects values that were not
# substituted correctly during generation (the raw value is shown in the
# error).
check_charset() {
	# $1: setting label, $2: value
	case "$2" in
	'' | *[!A-Za-z0-9._/-]*)
		fail "setting ${1} has an invalid value: '${2}' (empty, or characters outside a shell-safe set)"
		;;
	esac
}

# kubectl wrapper: every kubectl invocation goes through here and uses the
# private kubeconfig exported from the selected Kind cluster. The ambient
# context and the global kubeconfig are never used and never changed.
kctl() {
	kubectl --kubeconfig "$KUBECONFIG_FILE" "$@"
}

# helm wrapper: every helm invocation goes through here with the same
# private kubeconfig. Helm repository configuration and cache are kept in
# the private scratch directory (see Step 3), so the user's global helm
# state is never read or changed.
hlm() {
	helm --kubeconfig "$KUBECONFIG_FILE" "$@"
}

# Run the pinned kind CLI. GOWORK and GOFLAGS are cleared so consumer Go
# workspaces and flags cannot interfere. The container provider is not
# set or forced: kind uses the engine selected by the user's environment
# (KIND_EXPERIMENTAL_PROVIDER when set, otherwise autodetection — see
# the rationale at the baked settings above).
kind_run() {
	GOWORK=off GOFLAGS='' go run "sigs.k8s.io/kind@${KIND_VERSION}" "$@"
}

# ---------------------------------------------------------------------------
# Step 1: prerequisites
# ---------------------------------------------------------------------------

for prerequisite_cmd in go kubectl helm grep mktemp cut; do
	need_cmd "$prerequisite_cmd"
done

# Helm 3 client only: helm 2 talks to a server-side Tiller this script
# never sets up. 3.13 or newer is required because the Step 5 preflight
# reads an existing release's chart identity with 'helm get metadata',
# added in helm 3.13 ('helm status' cannot be used for this: it strips
# the chart from its output entirely).
helm_version="$(helm version --short 2>/dev/null)" ||
	fail "'helm version' failed; is helm a working Helm 3 client?"
case "$helm_version" in
v3.*) ;;
*) fail "helm 3.x is required (reported: '${helm_version}')" ;;
esac
helm_minor="${helm_version#v3.}"
helm_minor="${helm_minor%%.*}"
case "$helm_minor" in
'' | *[!0-9]*) fail "could not parse the helm minor version (reported: '${helm_version}')" ;;
esac
[ "$helm_minor" -ge 13 ] ||
	fail "helm 3.13 or newer is required (reported: '${helm_version}'): the preflight reads an existing release's chart with 'helm get metadata', added in helm 3.13"

# ---------------------------------------------------------------------------
# Step 2: validate the baked settings
# ---------------------------------------------------------------------------

check_charset "KIND_CLUSTER_NAME" "$KIND_CLUSTER_NAME"
check_charset "KIND_VERSION" "$KIND_VERSION"
check_charset "CERT_MANAGER_VERSION" "$CERT_MANAGER_VERSION"
case "$CERT_MANAGER_VERSION" in
v[0-9]*) ;;
*) fail "CERT_MANAGER_VERSION must be a 'v'-prefixed chart version (got: '${CERT_MANAGER_VERSION}')" ;;
esac
case "$CERT_MANAGER_NAMESPACE" in
'' | *[!a-z0-9-]*) fail "invalid CERT_MANAGER_NAMESPACE: '${CERT_MANAGER_NAMESPACE}' (must be a DNS-1123 label)" ;;
esac
case "$CERT_MANAGER_RELEASE_NAME" in
'' | *[!A-Za-z0-9-]*) fail "invalid CERT_MANAGER_RELEASE_NAME: '${CERT_MANAGER_RELEASE_NAME}'" ;;
esac

# ---------------------------------------------------------------------------
# Step 3: private scratch directory
# ---------------------------------------------------------------------------
# Everything this script writes (kubeconfig, helm repository config and
# cache) stays in a unique private directory created by mktemp in the
# system temporary directory (mktemp creates it mode 700), which is removed
# on exit.

SCRATCH_DIR="$(mktemp -d)" ||
	fail "could not create a private scratch directory with mktemp"

cleanup() {
	rm -rf "$SCRATCH_DIR"
}
trap cleanup EXIT

KUBECONFIG_FILE="${SCRATCH_DIR}/kubeconfig"
HELM_REPOSITORY_CONFIG="${SCRATCH_DIR}/helm/repositories.yaml"
HELM_REPOSITORY_CACHE="${SCRATCH_DIR}/helm/repository-cache"
mkdir -p "${SCRATCH_DIR}/helm"

# Keep helm's repository configuration and cache inside the private
# scratch: the user's global helm state is never read or changed, and
# nothing persists after the script exits.
export HELM_REPOSITORY_CONFIG HELM_REPOSITORY_CACHE

# ---------------------------------------------------------------------------
# Step 4: Kind target discovery (read-only; the first cluster mutation is
# the helm install in Step 6)
# ---------------------------------------------------------------------------

info "Verifying Kind cluster '${KIND_CLUSTER_NAME}' (kind ${KIND_VERSION})"

cluster_list="$(kind_run get clusters)" ||
	fail "kind ${KIND_VERSION} could not list clusters; is the container engine daemon running (kind uses the engine selected by your environment)?"

printf '%s\n' "$cluster_list" | grep -qx "$KIND_CLUSTER_NAME" ||
	fail "Kind cluster '${KIND_CLUSTER_NAME}' was not found. Clusters reported by kind: ${cluster_list:-<none>}"

if ! kind_run get kubeconfig --name "$KIND_CLUSTER_NAME" >"$KUBECONFIG_FILE"; then
	fail "could not export the kubeconfig of Kind cluster '${KIND_CLUSTER_NAME}'"
fi
chmod 600 "$KUBECONFIG_FILE"

info "Checking cluster reachability through the private kubeconfig"
if ! readyz_out="$(kctl get --raw /readyz 2>&1)"; then
	fail "cluster '${KIND_CLUSTER_NAME}' is not reachable through the exported kubeconfig: ${readyz_out}"
fi

# ---------------------------------------------------------------------------
# Step 5: read-only preflight — never take over a foreign installation
# ---------------------------------------------------------------------------

# Fail closed on read errors: only an exact NotFound result is read as
# absence. A Forbidden, timeout, or transient read error stops the
# script with zero writes — it is never interpreted as "not installed",
# which could lead to taking over a foreign installation.
if api_read_err="$(kctl get crd certificates.cert-manager.io 2>&1 >/dev/null)"; then
	api_present=yes
else
	case "$api_read_err" in
	*"NotFound"*) api_present=no ;;
	*)
		fail "could not check whether the CRD 'certificates.cert-manager.io' exists (read failed; refusing to continue): ${api_read_err}"
		;;
	esac
fi

release_present=no
if release_read_err="$(hlm status "$CERT_MANAGER_RELEASE_NAME" --namespace "$CERT_MANAGER_NAMESPACE" 2>&1 >/dev/null)"; then
	release_present=yes
else
	case "$release_read_err" in
	*"release: not found"*) release_present=no ;;
	*)
		fail "could not check whether Helm release '${CERT_MANAGER_RELEASE_NAME}' exists in namespace '${CERT_MANAGER_NAMESPACE}' (read failed; refusing to continue): ${release_read_err}"
		;;
	esac
fi

if [ "$release_present" = yes ]; then
	# The release existing is not enough: it must be a cert-manager
	# chart. A same-named release from any other chart is a foreign
	# installation this script must never take over — 'helm upgrade'
	# would replace its recorded manifest and delete resources the new
	# chart does not include. 'helm get metadata' is the reliable source
	# for the chart identity of an existing release: it reports the
	# installed chart's name as a plain string ('helm status' strips the
	# chart from its output entirely, so no chart can be read from it).
	if ! release_chart="$(hlm get metadata "$CERT_MANAGER_RELEASE_NAME" --namespace "$CERT_MANAGER_NAMESPACE" -o json 2>/dev/null | grep -o '"chart":[[:space:]]*"[^"]*"' | cut -d'"' -f4)"; then
		fail "could not read the chart of Helm release '${CERT_MANAGER_RELEASE_NAME}' in namespace '${CERT_MANAGER_NAMESPACE}'"
	fi
	[ -n "$release_chart" ] ||
		fail "Helm release '${CERT_MANAGER_RELEASE_NAME}' in namespace '${CERT_MANAGER_NAMESPACE}' reported an empty chart name; refusing to upgrade it"
	case "$release_chart" in
	cert-manager) ;;
	*)
		fail "Helm release '${CERT_MANAGER_RELEASE_NAME}' in namespace '${CERT_MANAGER_NAMESPACE}' was installed by chart '${release_chart}', not the cert-manager chart: this script never takes over, reinstalls, or deletes an installation it does not own. Manage or remove it explicitly, or adjust the release/namespace settings."
		;;
	esac
fi

if [ "$api_present" = yes ] && [ "$release_present" = no ]; then
	fail "cert-manager APIs already exist on cluster '${KIND_CLUSTER_NAME}' but Helm release '${CERT_MANAGER_RELEASE_NAME}' in namespace '${CERT_MANAGER_NAMESPACE}' was not found: cert-manager appears to be installed by other means. This script never takes over, reinstalls, or deletes an installation it does not own. Manage or remove it explicitly, or adjust the release/namespace settings."
fi

if [ "$release_present" = yes ]; then
	info "Helm release '${CERT_MANAGER_RELEASE_NAME}' found in namespace '${CERT_MANAGER_NAMESPACE}': this run upgrades it in place to chart version ${CERT_MANAGER_VERSION}"
else
	info "No existing cert-manager installation found: fresh install of chart version ${CERT_MANAGER_VERSION}"
fi

# ---------------------------------------------------------------------------
# Step 6: install the pinned chart
# ---------------------------------------------------------------------------

info "Adding Helm repository ${HELM_REPO_NAME} (${HELM_REPO_URL}) in private scratch (network required)"
if ! hlm repo add "$HELM_REPO_NAME" "$HELM_REPO_URL"; then
	fail "could not add the ${HELM_REPO_NAME} Helm repository"
fi
if ! hlm repo update "$HELM_REPO_NAME"; then
	fail "could not update the ${HELM_REPO_NAME} Helm repository index"
fi

info "Installing cert-manager ${CERT_MANAGER_VERSION} into namespace '${CERT_MANAGER_NAMESPACE}' (bounded wait: ${HELM_WAIT_TIMEOUT})"
# --reuse-values keeps an existing release's user-supplied values on the
# in-place upgrade (a fresh install has none to reuse); --set still forces
# crds.enabled=true for the pinned chart either way.
if ! install_out="$(hlm upgrade --install "$CERT_MANAGER_RELEASE_NAME" "${HELM_REPO_NAME}/cert-manager" \
	--namespace "$CERT_MANAGER_NAMESPACE" --create-namespace \
	--version "$CERT_MANAGER_VERSION" \
	--reuse-values \
	--set crds.enabled=true \
	--wait --timeout "$HELM_WAIT_TIMEOUT" 2>&1)"; then
	echo "ERROR: helm upgrade --install of cert-manager ${CERT_MANAGER_VERSION} failed: ${install_out}" >&2
	fail "installation stopped; partial state may exist and was NOT rolled back, uninstalled, or deleted"
fi

# ---------------------------------------------------------------------------
# Step 7: bounded verification
# ---------------------------------------------------------------------------

# The chart labels its workloads with the Helm release instance name, so
# the verification follows the release rather than hardcoded deployment
# names.
info "Waiting for the '${CERT_MANAGER_RELEASE_NAME}' deployments to become Available (bounded: ${DEPLOYMENT_TIMEOUT})"
if ! wait_out="$(kctl wait --for=condition=Available deployments \
	--namespace "$CERT_MANAGER_NAMESPACE" \
	--selector "app.kubernetes.io/instance=${CERT_MANAGER_RELEASE_NAME}" \
	--timeout="$DEPLOYMENT_TIMEOUT" 2>&1)"; then
	echo "ERROR: the cert-manager deployments did not become Available within ${DEPLOYMENT_TIMEOUT}: ${wait_out}" >&2
	fail "verification failed; the installation was NOT rolled back or uninstalled"
fi

info "Waiting for the certificates.cert-manager.io CRD to reach Established (bounded: ${CRD_ESTABLISHED_TIMEOUT})"
if ! wait_out="$(kctl wait --for=condition=Established crd/certificates.cert-manager.io --timeout="$CRD_ESTABLISHED_TIMEOUT" 2>&1)"; then
	echo "ERROR: certificates.cert-manager.io did not reach Established within ${CRD_ESTABLISHED_TIMEOUT}: ${wait_out}" >&2
	fail "verification failed; the installation was NOT rolled back or uninstalled"
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

info "Done: cert-manager ${CERT_MANAGER_VERSION} installed on cluster '${KIND_CLUSTER_NAME}' (release '${CERT_MANAGER_RELEASE_NAME}', namespace '${CERT_MANAGER_NAMESPACE}')"
info "cert-manager issues certificates; it does not configure Issuers, ClusterIssuers, or Certificate resources — those belong to the consumer."
